{
  "format_version": 2,
  "id": "example.instant-retry",
  "name": "Instant retry",
  "version": "0.1.0",
  "game_id": "nsmbu-usa",
  "author": "example",
  "description": "Soft checkpoint retry inside a course: record a safe landing, skip the usual death cutscene, restore the player, and hold jump to quit. Inspired by Tsuru instant respawn, not a copy of its code.",
  "kind": "lua",
  "lua": {
    "api_version": 1,
    "entry": "main.lua",
    "heap_size": 65536
  },
  "options": [
    {
      "id": "enabled",
      "name": "Instant retry",
      "type": "bool",
      "default": true
    },
    {
      "id": "keep_powerup",
      "name": "Keep power-up on retry",
      "type": "bool",
      "default": true
    },
    {
      "id": "cost_life",
      "name": "Spend a life on retry",
      "type": "bool",
      "default": false
    },
    {
      "id": "record_every",
      "name": "Logic steps between safe-spot samples",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 120,
      "step": 1
    },
    {
      "id": "quit_hold",
      "name": "Hold jump this many steps to quit",
      "type": "number",
      "default": 45,
      "min": 15,
      "max": 180,
      "step": 1
    }
  ]
}
