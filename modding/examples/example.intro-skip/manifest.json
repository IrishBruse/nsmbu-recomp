{
  "$schema": "../../sdk/manifest.schema.json",
  "format_version": 2,
  "id": "example.intro-skip",
  "name": "Intro skip",
  "version": "0.1.0",
  "game_id": "nsmbu-usa",
  "description": "Skips the opening into the world map for the chosen save file. It does not open time attack.",
  "kind": "luau",
  "luau": {
    "api_version": 1,
    "entry": "main.luau"
  },
  "options": [
    {
      "id": "save_file",
      "name": "Save file",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1
    }
  ]
}
