# game/ — dump, keys, extracted code/, content/, meta/; game/README.md stays in git
/game/*
!/game/README.md
/game/game.wux
/game/game.key
/game/common.key
*.rpx
# upstream reference checkout
/cemu/
# generated / build output
/build/
out/
__pycache__/
filelist.txt
extract.log
.DS_Store
/ref/
trace_dump.txt
/save/
/user/
compile_commands.json
.cache/
frame_*.png
failed_shader_*.metal
shaders/
draw_*.png
captures/
# never commit game data, keys or anything derived from the game
*.key
*.wud
*.wux
*.7z
*.iso
*.rvz
template.bin
shaderprep_template.bin
headstart.bin
# GameCube decompilation (zeldaret/tww), reference only
/tww/
# logs and dumps (may contain game text or imagery)
*.log
*.metal
*.tsv
# verified decompiled source (derived from the game): never published
/nsmbu_src/
# local coordination board
/task.md
/.tmp/

# LuaJIT Makefile outputs (also ignored under runtime/third_party/luajit/.gitignore)
/runtime/third_party/luajit/src/libluajit.a
/runtime/third_party/luajit/src/luajit
/runtime/third_party/luajit/src/*.o
/runtime/third_party/luajit/src/host/*.o
/runtime/third_party/luajit/src/host/minilua
/runtime/third_party/luajit/src/host/buildvm
/runtime/third_party/luajit/src/lj_vm.S
/runtime/third_party/luajit/src/lj_bcdef.h
/runtime/third_party/luajit/src/lj_ffdef.h
/runtime/third_party/luajit/src/lj_libdef.h
/runtime/third_party/luajit/src/lj_recdef.h
/runtime/third_party/luajit/src/lj_folddef.h
/runtime/third_party/luajit/src/luajit.h
/runtime/third_party/luajit/src/luajit_relver.txt

